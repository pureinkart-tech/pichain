    MAD distort.xy, dudv, 0.01, temp;

    TEX refract, distort, texture[3], 2D;
    TEX fade.a, temp, texture[3], 2D;
    MOV_SAT fade.r, fragment.position.z;
    MAD fade.a, fade, 4, projtc.z;
    MUL result.color.a, fade.a, fade.r;

    TEMP rvec;
