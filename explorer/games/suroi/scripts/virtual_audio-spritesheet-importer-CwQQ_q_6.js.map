export const importSpritesheet=async t=>{switch(t){case "normal":return await import("virtual:audio-spritesheet-normal");case "fall":return await import("virtual:audio-spritesheet-fall");case "halloween":return await import("virtual:audio-spritesheet-halloween");case "infection":return await import("virtual:audio-spritesheet-infection");case "birthday":return await import("virtual:audio-spritesheet-birthday");case "winter":return await import("virtual:audio-spritesheet-winter");case "hunted":return await import("virtual:audio-spritesheet-hunted");case "nye":return await import("virtual:audio-spritesheet-nye");}}