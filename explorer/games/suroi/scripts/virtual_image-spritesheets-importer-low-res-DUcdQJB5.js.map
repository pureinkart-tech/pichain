export const importSpritesheet=async t=>{switch(t){case "normal":return await import("virtual:image-spritesheets-low-res-normal");case "fall":return await import("virtual:image-spritesheets-low-res-fall");case "halloween":return await import("virtual:image-spritesheets-low-res-halloween");case "infection":return await import("virtual:image-spritesheets-low-res-infection");case "birthday":return await import("virtual:image-spritesheets-low-res-birthday");case "winter":return await import("virtual:image-spritesheets-low-res-winter");case "hunted":return await import("virtual:image-spritesheets-low-res-hunted");case "nye":return await import("virtual:image-spritesheets-low-res-nye");}}