{
  "productName": "PIChain Miner",
  "version": "0.7.8",
  "identifier": "net.pichain.miner",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PIChain Miner",
        "width": 860,
        "height": 720,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 520,
        "visible": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "PIChain"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
